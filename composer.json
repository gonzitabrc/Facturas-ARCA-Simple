{
    "name": "gonza/facturador-arca",
    "description": "Emisión de facturas electrónicas ARCA por lotes desde Excel/CSV",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "ext-soap": "*",
        "ext-openssl": "*",
        "ext-pdo_sqlite": "*",
        "ext-mbstring": "*",
        "ext-zip": "*",
        "ext-gd": "*",
        "phpoffice/phpspreadsheet": "^2.0",
        "dompdf/dompdf": "^3.0",
        "endroid/qr-code": "^5.0"
    },
    "autoload": {
        "psr-4": { "Facturador\\": "src/" }
    },
    "config": { "optimize-autoloader": true }
}
